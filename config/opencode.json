{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "default_agent": "sre-fix",
  "instructions": ["AGENTS.md", "CONTRIBUTING.md"],
  "permission": {
    "edit": {
      "*": "allow",
      ".github/**": "deny",
      "*.env*": "deny",
      "*secrets*": "deny",
      "*.pem": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git remote*": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "kubectl delete*": "deny",
      "kubectl apply*": "deny",
      "kubectl edit*": "deny",
      "kubectl patch*": "deny",
      "kubectl scale*": "deny",
      "kubectl rollout*": "deny",
      "kubectl exec*": "deny",
      "kubectl cordon*": "deny",
      "kubectl drain*": "deny",
      "helm upgrade*": "deny",
      "helm install*": "deny",
      "helm uninstall*": "deny",
      "terraform apply*": "deny",
      "terraform destroy*": "deny",
      "aws * create-*": "deny",
      "aws * delete-*": "deny",
      "aws * put-*": "deny",
      "aws * update-*": "deny",
      "aws * modify-*": "deny",
      "aws * terminate-*": "deny",
      "aws * start-*": "deny",
      "aws * stop-*": "deny",
      "aws * reboot-*": "deny",
      "aws * attach-*": "deny",
      "aws * detach-*": "deny",
      "aws * associate-*": "deny",
      "aws * disassociate-*": "deny",
      "aws * register-*": "deny",
      "aws * deregister-*": "deny",
      "aws * enable-*": "deny",
      "aws * disable-*": "deny",
      "aws * add-*": "deny",
      "aws * remove-*": "deny",
      "aws * reset-*": "deny",
      "aws * restore-*": "deny",
      "aws * import-*": "deny",
      "aws * copy-*": "deny",
      "aws * cancel-*": "deny",
      "aws * accept-*": "deny",
      "aws * reject-*": "deny",
      "aws * replace-*": "deny",
      "aws * revoke-*": "deny",
      "aws * authorize-*": "deny",
      "aws * tag-*": "deny",
      "aws * untag-*": "deny",
      "aws * publish-*": "deny",
      "aws * upload-*": "deny",
      "aws * invoke-*": "deny",
      "aws * run-*": "deny",
      "aws * send-*": "deny",
      "aws * set-*": "deny",
      "aws s3 cp*": "deny",
      "aws s3 mv*": "deny",
      "aws s3 rm*": "deny",
      "aws s3 sync*": "deny",
      "aws ssm start-session*": "deny",
      "aws ecs execute-command*": "deny"
    },
    "webfetch": "deny",
    "websearch": "deny",
    "task": "deny",
    "external_directory": "deny",
    "doom_loop": "deny",
    "question": "deny"
  }
}
