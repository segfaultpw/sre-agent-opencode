{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "default_agent": "sre-fix",
  "instructions": ["AGENTS.md", "CONTRIBUTING.md"],
  "permission": {
    "edit": {
      "*": "allow",
      ".github/**": "deny",
      "**/*.env*": "deny",
      "**/secrets*": "deny",
      "**/*.pem": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git remote*": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny"
    },
    "webfetch": "deny",
    "websearch": "deny",
    "task": "deny",
    "external_directory": "deny",
    "doom_loop": "deny",
    "question": "deny"
  }
}
